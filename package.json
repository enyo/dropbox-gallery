{
  "name": "dropbox-gallery",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vitest",
    "test": "vitest run",
    "lint": "oxfmt --check .",
    "format": "oxfmt --write .",
    "auth": "node scripts/dropbox-auth.mjs",
    "dropbox:check": "node scripts/dropbox-check.mjs",
    "admin:create": "node scripts/create-admin.mjs",
    "db:create": "wrangler d1 create dropbox-gallery",
    "db:migrate:local": "wrangler d1 migrations apply dropbox-gallery --local",
    "db:migrate": "wrangler d1 migrations apply dropbox-gallery --remote",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "photoswipe": "^5.4.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260808.1",
    "@standard-schema/spec": "^1.1.0",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.2.0",
    "oxfmt": "^0.58.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
